# Copy this file to .env.local and fill in what you need.
# The app runs with ZERO configuration — every variable below is optional.

# ── Email verification (optional) ──────────────────────────────────────
# Without this, new-account verification codes print to the terminal
# running `npm run dev` instead of being emailed. See README.md.
RESEND_API_KEY=

# ── On-chain Payment Links (optional, "Coming soon" until set) ────────
# Deploy contracts/FlowUSDPaymentLinks.sol yourself (see contracts/README.md)
# and paste the address here to enable the on-chain registry card.
NEXT_PUBLIC_PAYMENT_LINKS_CONTRACT_ADDRESS=

# ── On-chain Swap (optional, "Coming soon" until set) ──────────────────
# Deploy contracts/FlowSwapToken.sol then contracts/FlowUSDSwap.sol
# yourself (see contracts/README.md) and paste both addresses here.
NEXT_PUBLIC_SWAP_CONTRACT_ADDRESS=
NEXT_PUBLIC_SWAP_TOKEN_ADDRESS=
